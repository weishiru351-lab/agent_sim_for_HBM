{
  "version": 3,
  "workload": {
    "kind": "kv_events",
    "data": {
      "version": 3,
      "objects": {"A": {"tokens": 1, "dimensions": 4, "element_bytes": 2}},
      "events": [
        {"op": "create", "object": "A"},
        {"op": "append", "object": "A", "count": 1},
        {"op": "read", "object": "A", "tokens": [0, 1], "dimensions": [0, 4], "group_by": "token"},
        {"op": "invalidate", "object": "A"},
        {"op": "create", "object": "A"},
        {"op": "append", "object": "A", "count": 1},
        {"op": "invalidate", "object": "A"},
        {"op": "end"}
      ]
    }
  },
  "hardware": {
    "version": 1,
    "modules": ["m0"],
    "targets": {
      "t0": {
        "module": "m0",
        "medium": "dram",
        "links": ["bus"],
        "geometry": {"channels": 1, "banks_per_channel": 1, "rows": 1, "columns": 8, "granule_bytes": 8},
        "clock_period_ps": 1,
        "mapping_group": "dram"
      },
      "t1": {
        "module": "m0",
        "medium": "nand",
        "links": ["bus"],
        "geometry": {"channels": 1, "dies_per_channel": 1, "planes_per_die": 1, "blocks_per_plane": 4, "pages_per_block": 2, "page_bytes": 8},
        "logical_pages": 4,
        "management_bytes": 128
      }
    },
    "regions": {"main": {"target": "t0", "base_address": 0, "size_bytes": 16}, "cold": {"target": "t1", "base_address": 0, "size_bytes": 16}},
    "pools": {"memory": ["main", "cold"]},
    "links": {"bus": {"bytes_per_beat": 8, "beat_ps": 10, "latency_ps": 0}}
  },
  "execution": {"kind": "serial_groups", "allocation": "policy_first_fit", "migration": {"kind": "policy", "buffer_bytes": 8}},
  "design_space": {
    "vary": ["kv_layout", "dram_address_mapping", "allocation_policy", "migration_policy"],
    "layout_options": {"pool": "memory", "alignment_bytes": [8], "chunk_bytes": [8]},
    "migration_options": {"triggers": ["on_full", "before_read"], "destinations": ["cold"]}
  },
  "evaluation": {
    "backend": "fcfs",
    "objective": "completion_ps",
    "allocation_parameters": {"create_ps": 5, "invalidate_ps": 3, "reserve_ps": 7, "release_ps": 11},
    "nand_parameters": {"t1": {"read_ps": 30, "program_ps": 100, "erase_ps": 200, "transfer_ps": 10, "lookup_ps": 2, "merge_ps": 3, "bind_ps": 5}},
    "migration_parameters": {"publish_ps": 13, "copy_ps_per_byte": 1}
  },
  "budget": 20,
  "initial_design": {
    "dram_address_mapping": {"version": 1, "groups": {"dram": {"version": 0, "operations": []}}},
    "allocation_policy": {"version": 1, "reserve_on": {"A": "create"}},
    "migration_policy": {"version": 1, "objects": {"A": {"trigger": "never"}}},
    "kv_layout": {
      "version": 3,
      "objects": {"A": {"version": 1, "tile": {"token": 1, "dimension": 4}, "order": ["token_outer", "dimension_outer", "token_inner", "dimension_inner"]}},
      "groups": [{"composition": {"kind": "concat", "order": ["A"], "alignment_bytes": 8}, "placement": {"regions": ["main"], "stripe_bytes": 8}}]
    }
  }
}

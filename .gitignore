# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.env
.env.*
!.env.example
# Downloaded upstream sources and local build environments are reproducible inputs.
/.local/
/build/

# Generated simulator and plotting artifacts
*.vvp
matplotlib_cache/

# Paper full texts stay local; version only the catalog and bibliography.
/paper/*
!/paper/README.md
!/paper/references.bib

# Experiments are local by default; preserve only selected snapshots.
/results/*
!/results/provenance.json
!/results/baseline_v1/
!/results/baseline_v2/
!/results/agent_kv_v1/
!/results/rule_study_v1/
!/results/agent_v2_pilot/
!/results/agent_v2_diagnosis/
!/results/agent_v3_pilot/
!/results/kv_layout_v1/
/results/kv_layout_v1/*
!/results/kv_layout_v1/study.json

# Baseline summaries already contain the complete per-search JSON records.
/results/baseline_v1/*
!/results/baseline_v1/benchmark.json
!/results/baseline_v1/report.md
!/results/baseline_v1/convergence.png
/results/baseline_v2/*
!/results/baseline_v2/benchmark.json
!/results/baseline_v2/report.md
!/results/baseline_v2/convergence.png

# Rule-discovery study: protocol, compact raw results, and interpretation.
/results/rule_study_v1/*
!/results/rule_study_v1/protocol.json
!/results/rule_study_v1/discovery.json
!/results/rule_study_v1/validation.json
!/results/rule_study_v1/report.md

# Agent V2: comparison.json includes full histories; omit duplicate live sessions.
/results/agent_v2_pilot/*
!/results/agent_v2_pilot/protocol.json
!/results/agent_v2_pilot/comparison.json
!/results/agent_v2_pilot/report.md
!/results/agent_v2_pilot/convergence.png
!/results/agent_v2_pilot/traces/
!/results/agent_v2_pilot/one_shot/

# Post-search failure diagnosis; never replace the original search scores.
/results/agent_v2_diagnosis/*
!/results/agent_v2_diagnosis/diagnosis.json
!/results/agent_v2_diagnosis/report.md

# Independent-context prompt/feedback factorial pilot; full histories in comparison.
/results/agent_v3_pilot/*
!/results/agent_v3_pilot/protocol.json
!/results/agent_v3_pilot/execution.json
!/results/agent_v3_pilot/comparison.json
!/results/agent_v3_pilot/report.md
!/results/agent_v3_pilot/convergence.png
!/results/agent_v3_pilot/briefings/
!/results/agent_v3_pilot/inputs/
!/results/agent_v3_pilot/traces/
!/results/agent_v3_pilot/one_shot/
